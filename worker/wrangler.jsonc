{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopee-price-watcher",
  "main": "src/index-v3.js",
  "compatibility_date": "2026-08-07",
  "keep_vars": true,
  "observability": { "enabled": true },
  "secrets": {
    "required": ["APP_TOKEN", "BRAVE_SEARCH_API_KEY"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopee-price-watcher",
      "database_id": "e7038772-cd38-4683-9c59-83fc510855dc",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://shopee-theta-amber.vercel.app"
  }
}
