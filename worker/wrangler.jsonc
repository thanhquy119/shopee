{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shopee-price-watcher",
  "main": "src/index-v8.js",
  "compatibility_date": "2026-08-07",
  "keep_vars": true,
  "observability": { "enabled": true },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopee-price-watcher",
      "database_id": "e7038772-cd38-4683-9c59-83fc510855dc",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["5 17 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://shopee-theta-amber.vercel.app",
    "VERCEL_OIDC_ISSUER": "https://oidc.vercel.com/thanhquy1192212-gmailcoms-projects",
    "VERCEL_OIDC_AUDIENCE": "https://vercel.com/thanhquy1192212-gmailcoms-projects",
    "VERCEL_OIDC_SUBJECT": "owner:thanhquy1192212-gmailcoms-projects:project:shopee:environment:production"
  }
}
